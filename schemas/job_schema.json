{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "job_id",
    "attempt",
    "repo_id",
    "base_sha",
    "target_sha",
    "task_type",
    "focus",
    "deadline_seconds",
    "supervisor",
    "execution_route",
    "preferred_worker",
    "required_capabilities"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "mac-job/v1"
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{3,128}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "repo_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "review",
        "analyze",
        "fix",
        "prepare",
        "test",
        "sync",
        "self-update"
      ]
    },
    "focus": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1,
      "maxItems": 32
    },
    "write": {
      "type": "boolean"
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 128
    },
    "test_profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "policy_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "permission_profile": {
      "type": "string",
      "enum": [
        "observe",
        "standard-worktree",
        "operational",
        "privileged"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "prepare-registered-repo",
          "sync-registered-repo",
          "push-task-branch",
          "manage-pr",
          "install-user-tool",
          "restart-user-service",
          "self-update-runner"
        ]
      },
      "maxItems": 8
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "type": "string",
          "enum": [
            "metadata-only",
            "worktree",
            "registered-checkout"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 128
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "relay-only",
            "declared-remotes-and-registries"
          ]
        }
      }
    },
    "verification_profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,64}$"
      },
      "maxItems": 32
    },
    "owner_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approval_ref",
        "approved_at",
        "summary"
      ],
      "properties": {
        "approved_by": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "approved_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 64
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "deadline_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "supervisor": {
      "type": "string",
      "enum": [
        "mac-codex"
      ]
    },
    "execution_route": {
      "type": "string",
      "enum": [
        "auto",
        "ornith",
        "codex",
        "ornith-then-codex"
      ]
    },
    "preferred_worker": {
      "type": "string",
      "enum": [
        "ornith",
        "codex"
      ]
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,64}$"
      },
      "maxItems": 32
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "instructions": {
      "type": "string",
      "maxLength": 20000
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000
      },
      "maxItems": 128
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remote_url": {
          "type": "string",
          "maxLength": 2048
        },
        "branch": {
          "type": "string",
          "maxLength": 256
        },
        "source_channel_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "source_event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "context": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    }
  }
}
