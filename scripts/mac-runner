#!/bin/zsh
set -eu

script_dir=${0:A:h}
repository_root=${script_dir:h}
mac_runner_config=${MAC_RUNNER_CONFIG:-${repository_root}/config.toml}

if [[ -n ${MAC_RUNNER_PYTHON:-} ]]; then
  mac_runner_python=${MAC_RUNNER_PYTHON}
elif [[ -x /opt/homebrew/bin/python3 ]]; then
  mac_runner_python=/opt/homebrew/bin/python3
elif [[ -x /usr/local/bin/python3 ]]; then
  mac_runner_python=/usr/local/bin/python3
else
  mac_runner_python=python3
fi

exec "${mac_runner_python}" \
  "${repository_root}/runner.py" \
  --config "${mac_runner_config}" \
  "$@"
